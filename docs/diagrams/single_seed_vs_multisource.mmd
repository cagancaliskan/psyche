%% Nous — finding (e): single-seed degeneracy vs multi-source basins.
%% Same two-dense-communities-joined-by-a-thin-bridge graph, shown twice.
%% Structural/conceptual; the multi-source result is the asserted acceptance test.
flowchart TB
    subgraph SINGLE["Single seed -> ONE blob (degenerate)"]
        direction LR
        sc(("coffee<br/>SEED")):::seed
        sw((warmth)):::g
        sm((morning)):::g
        sz((cozy)):::g
        swk((work)):::g
        sd((desk)):::g
        sl((deadline)):::g
        ss((stress)):::g
        sc --- sw --- sz
        sc --- sm --- sz
        sc --- sz
        swk --- sd --- sl --- ss
        swk --- sl
        swk --- ss
        sc -. "thin bridge" .- swk
        snote["one connected, seed-rooted region;<br/>segmentation keys off DISTANCE, not community"]:::note
    end

    subgraph MULTI["Two sources -> TWO basins (seam at the bridge)"]
        direction LR
        mc(("coffee<br/>SOURCE")):::warm
        mw((warmth)):::warm
        mm((morning)):::warm
        mz((cozy)):::warm
        mwk(("work<br/>SOURCE")):::work
        md((desk)):::work
        ml((deadline)):::work
        ms((stress)):::work
        mc --- mw --- mz
        mc --- mm --- mz
        mc --- mz
        mwk --- md --- ml --- ms
        mwk --- ml
        mwk --- ms
        mc -. "seam" .- mwk
        mnote["each node joins the source that pulls it harder;<br/>the thin bridge becomes the seam BETWEEN basins"]:::note
    end

    SINGLE --> MULTI

    classDef seed fill:#fff3bf,stroke:#f08c00,color:#7e5109;
    classDef g fill:#f1f3f5,stroke:#868e96,color:#343a40;
    classDef warm fill:#ffe3e3,stroke:#e03131,color:#7b241c;
    classDef work fill:#d0ebff,stroke:#1971c2,color:#0b3d6b;
    classDef note fill:#ffffff,stroke:#adb5bd,color:#495057;
