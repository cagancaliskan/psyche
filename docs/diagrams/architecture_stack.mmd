%% Psyche: the four-layer stack with the honest PROVEN / EXPLORATORY boundary.
%% Arrows point downward = each layer READS the one below (pure reads).
flowchart TB
    L4["Layer 4 - perceive -> field -> coalitions -> 'thought' (end-to-end slice)<br/><b>EXPLORATORY</b> - runs &amp; deterministic; cognitive meaning NOT claimed.<br/>'strongest coalition = thought' is a placeholder for an unbuilt broadcast phase.<br/>On clustered real input it yields an incoherent thought (asserted known limitation)."]:::explore
    L3["Layer 3 - multi-source activation field (basins, dominant source)<br/><b>EXPLORATORY</b> - deterministic &amp; pure; reuses the proven spread per source."]:::explore
    L2["Layer 2 - spreading activation (hop-layered single-expansion, flow)<br/><b>PROVEN</b> - determinism, purity; principled approximation."]:::proven
    L1["Layer 1 - substrate store (nodes &amp; roads, decay, sticky closure)<br/><b>PROVEN</b> - determinism, integrity, purity."]:::proven

    L4 -->|reads| L3 -->|reads| L2 -->|reads| L1

    classDef proven fill:#e8f5e9,stroke:#2e7d32,color:#1b5e20;
    classDef explore fill:#e7f0fb,stroke:#1565c0,color:#0b3d6b;
