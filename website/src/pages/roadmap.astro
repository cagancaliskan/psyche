---
import StarlightPage from '@astrojs/starlight/components/StarlightPage.astro';
import Timeline from '../components/Timeline.tsx';
import TimelineList from '../components/TimelineList.astro';
import NowLine from '../components/NowLine.tsx';
import GateStepper from '../components/GateStepper.astro';
import plan from '../data/plan.json';
import { type Plan } from '../lib/plan.ts';
import { withBase } from '../lib/url.ts';

const p = plan as unknown as Plan;
const roadmapDoc = withBase('research/roadmap/');
const gatesDoc = withBase('research/gates/');
---

<StarlightPage
  frontmatter={{
    title: 'Roadmap and gates',
    description: 'Phases and decision gates of stage 2, spiking cognitive maps, rendered from the research plan.',
    tableOfContents: false,
  }}
>
  <div class="sx-wide">
    <p>
      These are the phases and gates of Psyche's current research line, stage 2: spiking cognitive maps. Every
      date here is read from one file, the research plan, at build time. A moved date keeps its original
      alongside it and gets a change-log entry. The text version is in <a href={roadmapDoc}>Roadmap</a>.
    </p>

    <NowLine client:visible plan={p} />

    <section class="sx-section">
      <h2>Phases</h2>
      <Timeline client:visible plan={p} />
      <TimelineList plan={p} />
    </section>

    <section class="sx-section">
      <h2>Decision gates</h2>
      <p>
        Each gate is decided against criteria written before the work it judges. Public status shows only
        whether a gate is decided; verdicts are disclosed when the paper is submitted. Details in <a href={gatesDoc}>Decision gates</a>.
      </p>
      <GateStepper plan={p} />
    </section>
  </div>
</StarlightPage>
