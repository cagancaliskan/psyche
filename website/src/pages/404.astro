---
// The page for an address that does not exist, served as 404.html: the page kit's not-found page as its
// design lays it out, with a way back to the start. Every word, the figure still and the script come from
// src/kit/pages/not-found/ (written by the page import, never by hand). Its head is lib/head.ts's
// notFound entry (lib/seo.ts NOT_FOUND): the title "Page not found" and noindex. No menu item is marked
// as the current page.
import Kit from '@/layouts/Kit.astro';
import { PAGES } from '@/lib/head.ts';
import Main from '@/kit/pages/not-found/Main.astro';
import { body, skip } from '@/kit/pages/not-found/page.ts';
import '@/kit/pages/not-found/page.css';
import pageJs from '@/kit/pages/not-found/page.js?url';
---

<Kit page={PAGES.notFound} body={body} skip={skip} pageScript={pageJs}><Main /></Kit>
