---
// The test battery, set as a drafting sheet set in the landing's language (see the landing's Fig. 1,
// components/landing/MazeFigure.astro): a short lead, two ruled notes, then one sheet per test
// from components/BatteryExplorer.tsx. A wider content width for this page only, as the roadmap and
// status pages do with .sx-wide (styles/battery.css). The notes are two hairline-ruled rows, a mono
// label and its text, after "Spec Sheet" by isaiahbjork (21st.dev). The island hydrates when it
// scrolls into view; without script its Pause control would do nothing, so the noscript rule hides it.
import StarlightPage from '@astrojs/starlight/components/StarlightPage.astro';
import BatteryExplorer from '@/components/BatteryExplorer.tsx';
import { withBase } from '@/lib/url.ts';
import '@/styles/battery.css';

const textVersion = withBase('research/test-battery/');
---

<StarlightPage
  frontmatter={{
    title: 'The test battery',
    description: 'Five classic cognitive-map paradigms, illustrated step by step.',
    tableOfContents: false,
  }}
>
  <div class="sx-bat not-content">
    <header class="sx-bat__intro">
      <p class="sx-bat__lead">
        The battery is built from five classic behavioural paradigms. Each was designed to probe behaviour
        that memorised responses would not explain.
      </p>
      <ul class="sx-bnotes" role="list">
        <li>
          <p class="sx-bnotes__k">Pre-registered</p>
          <p class="sx-bnotes__t">Protocol details and pass criteria are pre-registered and stay private until release.</p>
        </li>
        <li>
          <p class="sx-bnotes__k">Text version</p>
          <p class="sx-bnotes__t">The text version, with the fairness rules, is in <a href={textVersion}>Test battery</a>.</p>
        </li>
      </ul>
    </header>
    <BatteryExplorer client:visible />
    <noscript><style is:inline>.sx-bs__ctl{display:none}</style></noscript>
  </div>
</StarlightPage>
