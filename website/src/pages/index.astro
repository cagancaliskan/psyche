---
// The home page: the film. One scroll-driven scene drawn with three.js (the installed dependency,
// bundled by the build), its captions over it, and the links to What we're building, the blog and
// About at its end. The film's markup, style and script are in src/kit/film/, brought in from the page
// design as they are (do not edit them here); this file only puts them on the bare layout.
//
// - The head is lib/head.ts's home entry: the whole title, the description, the structured data.
// - The theme is fixed dark: the film has no light version.
// - Without script, or under reduced motion, or without WebGL, the static page in the film's markup
//   shows instead: the same captions and the same links, as plain text. The <noscript> style in the
//   head is what shows it when no script runs at all.
// - The film's script is a module that Astro bundles: it imports three.js and the shape generator
//   (gen.js, as text, so the generator ships inside the film's chunk and counts in the page's budget).
import Bare from '@/layouts/Bare.astro';
import FilmBody from '@/kit/film/Body.astro';
import Noscript from '@/kit/film/Noscript.astro';
import { PAGES } from '@/lib/head.ts';
import '@/kit/film/film.css';
---

<Bare page={PAGES.home} fixedTheme="dark">
  <Noscript slot="head" />
  <FilmBody />
  <script>
    import '@/kit/film/film.js';
  </script>
</Bare>
