---
import StarlightPage from '@astrojs/starlight/components/StarlightPage.astro';
import LayersHero from '@/components/LayersHero.astro';
import NowLine from '@/components/NowLine.tsx';
import Timeline from '@/components/Timeline.tsx';
import TimelineList from '@/components/TimelineList.astro';
import BatteryTeaser from '@/components/battery/BatteryTeaser.astro';
import CaliperRail from '@/components/landing/CaliperRail.astro';
import HowBuilt from '@/components/landing/HowBuilt.astro';
import MazeFigure from '@/components/landing/MazeFigure.astro';
import PublicWithheld from '@/components/landing/PublicWithheld.astro';
import SectionHeader from '@/components/landing/SectionHeader.astro';
import StageLedger from '@/components/landing/StageLedger.astro';
import SubstrateReadout from '@/components/landing/SubstrateReadout.astro';
import plan from '@/data/plan.json';
import ledger from '@/data/ledger.public.json';
import type { PublicLedger } from '@/lib/ledger.ts';
import type { Plan } from '@/lib/plan.ts';
import { withBase } from '@/lib/url.ts';
import '@/styles/landing.css';
import '@/styles/landing/links.css';
import '@/styles/landing/roadmap.css';

const p = plan as unknown as Plan;
const led = ledger as unknown as PublicLedger;
const t = led.tests;
const { interpreters, hash_seeds } = led.determinism;

const stats = [
  { label: 'Suites', value: t.suites },
  { label: 'Assertions', value: t.assertions },
  { label: 'Failures', value: t.failures },
  { label: 'CPython versions', value: interpreters.length, detail: `${interpreters[0]} to ${interpreters[interpreters.length - 1]}` },
  { label: 'Hash seeds', value: hash_seeds.length, detail: hash_seeds.join(', ') },
];
---

<StarlightPage
  frontmatter={{
    // The page's own title; Starlight adds the site name after it.
    title: 'An open research project toward AGI',
    description:
      'Psyche, an open research project building toward artificial general intelligence from original, brain-inspired components. Stage 2, spiking cognitive maps, is active.',
    template: 'splash',
    // The page ends on its last section, not on a link to the next docs page.
    prev: false,
    next: false,
  }}
>
  <div class="sx-landing not-content">
    <LayersHero />
  </div>

  <div class="sx-lp">
    <div class="sx-landing-now">
      <NowLine client:idle plan={p} label="Now in stage 2" />
    </div>

    <StageLedger />

    <section class="sx-lp-section not-content" aria-labelledby="sx-battery-title" data-caliper="02 Battery">
      <SectionHeader id="sx-battery-title" title="The test battery" index="02" kicker="Battery">
        <p>The classic behavioural paradigms the battery is built from, drawn as illustrations, not results.</p>
      </SectionHeader>
      <div class="sx-lp-stack">
        <MazeFigure />
        <BatteryTeaser />
      </div>
    </section>

    <section class="sx-lp-section" aria-labelledby="sx-roadmap-title" data-caliper="03 Roadmap">
      <div class="not-content">
        <SectionHeader id="sx-roadmap-title" title="Stage 2 roadmap" index="03" kicker="Roadmap">
          <p>The current research line, <cite>{p.line.title}</cite>, runs in {p.phases.length} phases with {p.gates.length} decision gates. Choose a phase to see what it delivers; the full schedule is on the <a class="sx-lp-a" href={withBase('roadmap/')}>roadmap page</a>.</p>
        </SectionHeader>
      </div>
      <div class="sx-landing-roadmap" data-reveal>
        <Timeline client:visible plan={p} />
        <TimelineList plan={p} />
      </div>
    </section>

    <HowBuilt />

    <PublicWithheld />

    <section class="sx-lp-section not-content" aria-labelledby="sx-substrate-title" data-caliper="06 Substrate">
      <SectionHeader id="sx-substrate-title" title="The substrate, maintained" index="06" kicker="Substrate">
        <p>The substrate's development is {led.program.substrate.state}, and its record stays here and stays verified.</p>
      </SectionHeader>
      <div data-reveal>
        <SubstrateReadout items={stats} />
      </div>
      <p class="sx-lp-links" data-reveal>
        <a class="sx-lp-link" href={withBase('status/')}>See the substrate's status</a>
        <a class="sx-lp-link" href={withBase('substrate/overview/')}>Read what the substrate is</a>
      </p>
    </section>
  </div>

  <CaliperRail />
</StarlightPage>

<script>
  // Scroll reveals through one shared observer, after "Reveal" by asanshay (21st.dev), without its
  // motion dependency: blocks below the fold wait, then fade and rise once as they enter. Blocks
  // already on screen are never hidden, and with reduced motion nothing waits.
  const blocks = [...document.querySelectorAll<HTMLElement>('[data-reveal]')];
  if (blocks.length > 0 && 'IntersectionObserver' in window && matchMedia('(prefers-reduced-motion: no-preference)').matches) {
    const seen = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          if (!entry.isIntersecting) continue;
          seen.unobserve(entry.target);
          (entry.target as HTMLElement).dataset.reveal = 'in';
        }
      },
      { rootMargin: '0px 0px -8% 0px', threshold: 0.08 },
    );
    const fold = innerHeight;
    for (const block of blocks) {
      if (block.getBoundingClientRect().top < fold) continue;
      const peers = [...(block.parentElement?.children ?? [])].filter((el) => el.hasAttribute('data-reveal'));
      block.style.setProperty('--sx-delay', `${Math.min(Math.max(peers.indexOf(block), 0), 5) * 60}ms`);
      block.dataset.reveal = 'wait';
      seen.observe(block);
    }
    addEventListener('beforeprint', () => blocks.forEach((block) => (block.dataset.reveal = 'in')));
    // A block that is still waiting is shown the moment focus moves into it, so a focused link is
    // never invisible.
    addEventListener('focusin', (e) => {
      const block = e.target instanceof Element ? e.target.closest<HTMLElement>('[data-reveal="wait"]') : null;
      if (block) block.dataset.reveal = 'in';
    });
  }
</script>
