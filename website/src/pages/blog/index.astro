---
// The blog's index, at /blog/: the page kit's blog page as its design lays it out, its opening (the word
// on its line of days) from src/kit/pages/blog/ (written by the page import, never by hand), then every
// published post, newest first, each as its title linking to the post and the day it was published in
// words. The posts are read from src/data/blog.json, which tools/publish/stage.py writes from the posts
// of docs/blog/ in the commit being built; nothing is typed here per post.
//
// The title line below is also the Blog item's sidebar label, which tools/publish/test_core.py reads
// from this file.
import Kit from '@/layouts/Kit.astro';
import blog from '@/data/blog.json';
import type { BlogData } from '@/lib/blog.ts';
import { PAGES } from '@/lib/head.ts';
import { formatDay } from '@/lib/plan.ts';
import { withBase } from '@/lib/url.ts';
import Main from '@/kit/pages/blog/Main.astro';
import { body, skip } from '@/kit/pages/blog/page.ts';
import '@/kit/pages/blog/page.css';
import pageJs from '@/kit/pages/blog/page.js?url';

const page = {
  ...PAGES.blog,
  title: 'Blog',
};
// Newest first by the day of publication; stage.py already writes them so, and the sort keeps its order
// for posts of the same day.
const posts = [...(blog as BlogData).posts].sort((a, b) => (a.date < b.date ? 1 : a.date > b.date ? -1 : 0));
---

<Kit page={page} body={body} skip={skip} current="blog" pageScript={pageJs}><Main>{posts.map((p) => <li class="b-entry"><h2 class="b-entry__title k-list-title"><a href={withBase(p.route)}>{p.title}</a></h2>{' '}<time class="b-date" data-k-date datetime={p.date}>{formatDay(p.date)}</time></li>)}</Main></Kit>
