---
// The blog's posts, at /blog/<slug>/: each staged post of the `posts` collection (src/content.config.ts),
// its Markdown rendered as it is, on the page kit (layouts/Post.astro). The documents' route
// (src/pages/[...slug].astro) renders none of them: its `docs` collection leaves blog/ out. A post with a page design of its own has its Markdown laid out
// in the design's reading columns, with its figures between them, while it is rendered
// (scripts/post-figures.mjs); its words are the Markdown's.
import { getCollection, render } from 'astro:content';
import Post from '@/layouts/Post.astro';

export async function getStaticPaths() {
  const posts = await getCollection('posts');
  return posts.map((post) => ({ params: { slug: post.id }, props: { post } }));
}

const { post } = Astro.props;
const { Content } = await render(post);
---

<Post slug={post.id} data={post.data}>
  <Content />
</Post>
