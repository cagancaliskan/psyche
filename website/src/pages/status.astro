---
// Substrate status: the captured test run of the substrate (stage 1), where its development stands, and
// each of its bricks on two separate axes, its build status and its meaning verdict, in the
// documentation's frame (layouts/Docs.astro). Every number, date, state and name is read from the public
// ledger projection (src/data/ledger.public.json, staged from tools/ledger.json) through lib/status.ts;
// none is typed here. Public text says "verified" for the ledger's PROVEN (D-035).
//
// On a phone the brick tables are drawn as grids, which would drop a table's meaning for assistive
// technology, so every table part carries its role in the markup.
//
// The designed bricks are folded behind one plain-word control; a small script makes its first word say
// what it will do ("Show" while folded, "Hide" while open).
import docs from '@/data/docs.json';
import ledger from '@/data/ledger.public.json';
import DocEdit from '@/components/devdocs/DocEdit.astro';
import DocPager from '@/components/devdocs/DocPager.astro';
import OnThisPage from '@/components/devdocs/OnThisPage.astro';
import Docs from '@/layouts/Docs.astro';
import { entriesOf, neighbours, pageEditUrl, type DocsData } from '@/lib/devdocs.ts';
import { PAGES } from '@/lib/head.ts';
import { lastUpdatedOf } from '@/lib/lastUpdated.ts';
import { stateLabel, type PublicLedger } from '@/lib/ledger.ts';
import { formatDay } from '@/lib/plan.ts';
import { brickRows, keyOf, substrateReadout, type BrickRow } from '@/lib/status.ts';
import { withBase } from '@/lib/url.ts';

const page = {
  ...PAGES.status,
  title: 'Substrate status',
};
const led = ledger as unknown as PublicLedger;
const t = led.tests;
const substrate = led.program.substrate;
const maps = led.program.cognitive_map;
const since = formatDay(substrate.since);
const capturedOn = formatDay(t.captured_at.slice(0, 10));
const meaningBar = stateLabel(String(led.meaning_bar.status).toLowerCase());
const bar = String(led.meaning_bar.status).toLowerCase();
const noteTitle = `${stateLabel(substrate.state)} and maintained`;

// Every number in the run is read from the ledger projection.
const run = substrateReadout(led);
const fmt = new Intl.NumberFormat('en-US');

const rows = brickRows(led.bricks);
const shown = rows.filter((r) => r.build?.state !== 'designed');
const designed = rows.filter((r) => r.build?.state === 'designed');
const buildKey = keyOf(rows.map((r) => r.build));
const meaningKey = keyOf(rows.map((r) => r.meaning));
// The ledger's own name for the state, as the first brick in it carries it.
const ledgerName = (state: string) => rows.find((r) => r.build?.state === state)?.status;
const plural = (n: number) => (n === 1 ? 'brick' : 'bricks');

// What each state means, in plain words. The counts and the ledger names are not typed here.
const buildNote: Record<string, string> = {
  verified: 'Deterministic, integrity-preserving and pure, verified in a separate tester pass.',
  built: 'Meaning not validated. The mechanism is tester-verified; no cognitive claim is made.',
  designed: 'Specified only, not built.',
  horizon: 'Open research, with no agreed definition of done.',
  other: 'A state outside the ones above, as the ledger records it.',
};
const meaningNote: Record<string, string> = {
  earned: 'Reproduced on external data the project did not author, against a baseline.',
  'not-yet': 'Attempted; the effect has not yet been shown against external data.',
  'no-go': 'Stopped before a graded run. Attempts at a cognitive claim stopped before any graded number existed, each at its own wall: a circular yardstick, or a mechanism the effect needs that the engine lacks.',
};

const tables: { rows: BrickRow[]; name: string }[] = [
  { rows: shown, name: 'Bricks, each with its build status and its meaning verdict' },
  { rows: designed, name: 'Designed bricks, each with its build status and its meaning verdict' },
];

const overview = withBase('substrate/overview/');
const architecture = withBase('substrate/architecture/');
const methodology = withBase('substrate/methodology/');

// The heading ids are the ones the page had before it moved into this frame, so links to its parts keep
// landing on them; its two old section titles ("Test run", "Build status") gave way to the ones below.
const headings = [
  { depth: 2, slug: 'sx-status-run', text: 'The captured test run' },
  { depth: 2, slug: 'sx-status-bricks', text: 'Bricks' },
  { depth: 3, slug: 'sx-key-build', text: 'Build status' },
  { depth: 3, slug: 'sx-key-meaning', text: 'Meaning verdict' },
];
const { prev, next } = neighbours(entriesOf(docs as DocsData), page.route);
const updated = lastUpdatedOf(page.route)?.iso ?? null;
---

<Docs page={page} here={page.route} skip={{ href: '#doc', text: 'Skip to the text' }}>
  <main id="doc" class="k-doc" tabindex="-1">
    <article class="k-doc__body">
      <h1 class="k-doc__title">{page.title}</h1>
      <p class="k-doc__desc">{page.description}</p>

      <h2 id="sx-status-run">The captured test run</h2>
      <div class="st-runbox"><dl class="st-run">
        {run.map((item) => (
          <div class="st-run__cell"><dt>{item.label}</dt><dd class="st-run__fig">{fmt.format(item.value)}</dd>{item.detail && <dd class="st-run__detail">{item.detail}</dd>}</div>
        ))}
      </dl></div>
      <dl class="st-facts">
        <div class="st-facts__row"><dt>Captured</dt><dd>{capturedOn}, CPython {t.captured_python}</dd></div>
        <div class="st-facts__row"><dt>Counts</dt><dd>Identical on every version listed</dd></div>
        <div class="st-facts__row"><dt>Determinism</dt><dd>Probed under each hash seed</dd></div>
        <div class="st-facts__row"><dt>Meaning bar</dt><dd>{meaningBar}</dd></div>
      </dl>

      <div class="st-note" role="note" aria-label={noteTitle}>
        <p><strong>{noteTitle}</strong></p>
        <p>The substrate is Psyche's stage 1 and its foundation. Its development has been {substrate.state} since {since} (decision <span class="st-nowrap">{substrate.decision}</span>), while stage 2, spiking cognitive maps, is {maps.state}. No new work starts on the substrate; its tests and checks stay maintained.</p>
      </div>

      <p>
        The substrate is a dependency-free Python memory-and-activation substrate. What it shows is that its lower
        layers are correct and deterministic. It makes no claim that any layer reproduces a cognitive effect.
      </p>
      <p>
        Three attempts to grade a cognitive effect were stopped before any graded run, each at a structurally
        distinct wall: semantic priming was circular, the fan effect found the mechanism absent, and interoception
        found the signal flat. The finding is scoped to this substrate and these three yardsticks. The recurring
        obstacle, an external yardstick that the project did not author, is the lesson stage 2 is built around. Its
        behavioural paradigms are published, and its baselines are reproduced against their published behaviour;
        the agent-side operationalisation and the pass criteria are the project's own and are pre-registered
        privately.
      </p>

      <h2 id="sx-status-bricks">Bricks</h2>
      <p>
        Each brick of the substrate with its build status, as the ledger records it, and its meaning verdict. The two
        are separate axes: a brick can be built and verified while no meaning verdict has been earned.
      </p>
      <p>
        Brick names such as &ldquo;the depression path&rdquo; name mechanisms in the substrate, not clinical models.
      </p>

      <h3 id="sx-key-build">Build status</h3>
      <p class="st-ask">Is the mechanism built, and verified?</p>
      <ul class="st-key">
        {buildKey.map((e) => (
          <li><span class="st-key__state">{e.label}</span><span class="st-key__count">{e.count} {plural(e.count)}</span><div class="st-key__notes"><p>{buildNote[e.state]}</p>{e.state === 'verified' && <p>Ledger status <code>{ledgerName(e.state)}</code>: verified by the full adversarial suite on every interpreter; not a formal proof.</p>}</div></li>
        ))}
      </ul>

      <h3 id="sx-key-meaning">Meaning verdict</h3>
      <p class="st-ask">Does it reproduce a cognitive effect, judged against external data?</p>
      <ul class="st-key">
        {meaningKey.map((e) => (
          <li><span class="st-key__state">{e.label}</span><span class="st-key__count">{e.count} {plural(e.count)}</span><div class="st-key__notes"><p>{e.state === 'not-earned' ? `No meaning verdict has been earned. The meaning bar is ${bar}.` : meaningNote[e.state]}</p></div></li>
        ))}
      </ul>

      {tables.map((table, i) => {
        if (table.rows.length === 0) return null;
        const body = (
          <table class="st-brk" role="table" aria-label={table.name}>
            <colgroup><col class="st-brk__c-id" /><col /><col class="st-brk__c-st" /><col class="st-brk__c-st" /></colgroup>
            <thead role="rowgroup">
              <tr role="row"><th scope="col" role="columnheader">Brick</th><th scope="col" role="columnheader">Name</th><th scope="col" role="columnheader">Build status</th><th scope="col" role="columnheader">Meaning verdict</th></tr>
            </thead>
            <tbody role="rowgroup">
              {table.rows.map((r) => (
                <tr role="row"><th scope="row" role="rowheader"><code>{r.id}</code></th><td role="cell" data-label="Name" class="st-brk__name">{r.name}</td><td role="cell" data-label="Build status" class="st-brk__st">{r.build ? r.build.label : 'None recorded'}</td><td role="cell" data-label="Meaning verdict" class="st-brk__st">{r.meaning.label}</td></tr>
              ))}
            </tbody>
          </table>
        );
        return i === 0 ? body : (
          <details class="st-more" data-st-more>
            <summary><span data-st-verb>Show</span> the {table.rows.length} designed {plural(table.rows.length)}</summary>
            {body}
          </details>
        );
      })}

      <p>
        Read more: <a href={overview}>The substrate</a>, <a href={architecture}>Architecture</a> and <a href={methodology}>Methodology</a>.
      </p>
    </article>
    <DocPager prev={prev} next={next} />
    <DocEdit editUrl={pageEditUrl(page.route)} updated={updated} />
  </main>
  <OnThisPage slot="aside" headings={headings} />
</Docs>

<script>
  // The designed bricks' control names what it will do: "Show" while folded, "Hide" while open.
  for (const more of document.querySelectorAll<HTMLDetailsElement>('details[data-st-more]')) {
    const verb = more.querySelector<HTMLElement>('[data-st-verb]');
    if (!verb) continue;
    more.addEventListener('toggle', () => {
      verb.textContent = more.open ? 'Hide' : 'Show';
    });
  }
</script>
