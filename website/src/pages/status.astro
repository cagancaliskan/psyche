---
import StarlightPage from '@astrojs/starlight/components/StarlightPage.astro';
import { Aside } from '@astrojs/starlight/components';
import BrickBoard from '../components/BrickBoard.astro';
import StatsBand from '../components/ui/StatsBand.astro';
import ledger from '../data/ledger.public.json';
import { withBase } from '../lib/url.ts';
import { formatDay } from '../lib/plan.ts';
import { stateLabel, type PublicLedger } from '../lib/ledger.ts';
import '../styles/docs-visuals.css';

const led = ledger as unknown as PublicLedger;
const t = led.tests;
const interpreters = led.determinism.interpreters;
const seeds = led.determinism.hash_seeds;
const substrate = led.program.substrate;
const maps = led.program.cognitive_map;
const since = formatDay(substrate.since);
const capturedOn = formatDay(t.captured_at.slice(0, 10));
const meaningBar = String(led.meaning_bar.status).toLowerCase();

// Every number in the band is read from the ledger projection.
const stats = [
  { label: 'Suites', value: t.suites },
  { label: 'Assertions', value: t.assertions },
  { label: 'Failures', value: t.failures },
  { label: 'CPython versions', value: interpreters.length, detail: interpreters.join(', ') },
  { label: 'Hash seeds', value: seeds.length, detail: seeds.join(', ') },
];
const overview = withBase('substrate/overview/');
const architecture = withBase('substrate/architecture/');
const methodology = withBase('substrate/methodology/');
---

<StarlightPage
  frontmatter={{
    title: 'Substrate status',
    description: "The substrate, Psyche's stage 1 and its foundation: what is built, what is verified, and what was stopped.",
    tableOfContents: false,
  }}
>
  <div class="sx-wide">
    <p class="sx-kicker sx-status-kicker"><span class="sx-kicker__index">01</span> Test run</p>
    <StatsBand title="The captured test run" items={stats}>
      Captured on {capturedOn} with CPython {t.captured_python}. The counts are identical on every version listed, and determinism is probed under each hash seed. The meaning bar is {meaningBar}.
    </StatsBand>

    <Aside type="note" title={`${stateLabel(substrate.state)} and maintained`}>
      The substrate is Psyche's stage 1 and its foundation. Its development has been {substrate.state} since {since} (decision {substrate.decision}), while stage 2, spiking cognitive maps, is {maps.state}. No new work starts on the substrate; its tests and checks stay maintained.
    </Aside>

    <p>
      The substrate is a dependency-free Python memory-and-activation substrate. What it shows is that its lower
      layers are correct and deterministic. It makes no claim that any layer reproduces a cognitive effect.
    </p>
    <p>
      Three attempts to grade a cognitive effect were stopped before any graded run, each at a structurally
      distinct wall: semantic priming was circular, the fan effect found the mechanism absent, and interoception
      found the signal flat. The finding is scoped to this substrate and these three yardsticks. The recurring
      obstacle, the external yardstick, is the lesson stage 2 is built around: classic behavioural tests with
      published protocols, and baselines reproduced against their published behaviour.
    </p>

    <section class="sx-section">
      <p class="sx-kicker"><span class="sx-kicker__index">02</span> Build status</p>
      <h2>Bricks</h2>
      <p>Each brick of the substrate, grouped by its build status in the ledger.</p>
      <BrickBoard />
    </section>

    <p>
      Read more: <a href={overview}>The substrate</a>, <a href={architecture}>Architecture</a> and <a href={methodology}>Methodology</a>.
    </p>
  </div>
</StarlightPage>
