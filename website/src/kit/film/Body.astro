---
// The film's page: the site header (the wordmark and the four menu links, as on every page, with an
// empty place where the theme switch stands: the film is dark only) and its phone menu, the scroll
// track with its canvas and captions, and the static page shown under reduced motion or without
// WebGL. Imported from the page design with links set to the site's routes. Written by the page
// import: do not edit here.
import { withBase } from '@/lib/url.ts';
---
<header class="k-head">{' '}
  <a class="k-head__home" href={withBase('')} aria-label="Psyche, home"><img src={withBase('brand/psyche-wordmark-dark.svg')} alt="" width="118" height="19"></a>{' '}
  <nav class="k-head__nav" aria-label="Site"><a class="k-head__link" href={withBase('what-were-building/')} data-text="What we're building">What we're building</a><a class="k-head__link" href={withBase('experiments/')} data-text="Experiments">Experiments</a><a class="k-head__link" href={withBase('blog/')} data-text="Blog">Blog</a><a class="k-head__link" href={withBase('about/')} data-text="Contact">Contact</a></nav>{' '}
  <div class="k-head__end"><span class="k-head__theme" aria-hidden="true"></span><button type="button" class="k-ctl k-head__menu" data-k-menu aria-haspopup="dialog" aria-expanded="false" aria-controls="k-menu">Menu</button></div>{' '}
</header>{' '}
<div class="k-menu" id="k-menu" role="dialog" aria-modal="true" aria-label="Menu" hidden>{' '}
  <div class="k-menu__top"><a class="k-head__home" href={withBase('')} aria-label="Psyche, home"><img src={withBase('brand/psyche-wordmark-dark.svg')} alt="" width="118" height="19"></a><button type="button" class="k-ctl" data-k-close>Close</button></div>{' '}
  <nav class="k-menu__list" aria-label="Site"><a class="k-menu__link" href={withBase('what-were-building/')}>What we're building</a><a class="k-menu__link" href={withBase('experiments/')}>Experiments</a><a class="k-menu__link" href={withBase('blog/')}>Blog</a><a class="k-menu__link" href={withBase('about/')}>Contact</a></nav>{' '}
</div>{' '}

<main id="track">{' '}
  <div class="stage">{' '}
    <canvas id="scene" aria-hidden="true"></canvas>{' '}
    <p class="caption" data-beat="1">The most powerful intelligence ever known. It starts here.</p>{' '}
    <p class="caption" data-beat="2">Eighty-six billion neurons. Each one a tree, listening on thousands of branches.</p>{' '}
    <p class="caption long" data-beat="3">Where two of them meet, learning happens. No teacher and no master plan: a connection grows stronger each time it is used.</p>{' '}
    <p class="caption long" data-beat="4">How deep does it go? Some physicists look for the answer in quantum effects inside the cell itself. We keep that question open.</p>{' '}
    <p class="caption" data-beat="5">Then a spike. All or nothing. The brain's own one and zero.</p>{' '}
    <p class="caption" data-beat="6">We rebuild that pulse in a machine. Charge rises, crosses a threshold, fires.</p>{' '}
    <p class="caption long" data-beat="7">Our bet: wire thousands together, let each learn only from its neighbours, and the network draws its own map of the world.</p>{' '}
    <svg class="markvec" id="markvec" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 26 24" aria-hidden="true"><path d="M3.6 1.59H17.1A5.45 5.45 0 0 1 17.1 12.49H6.84" stroke="#f4f6fb" stroke-width="1.68" stroke-linejoin="round" fill="none"/><path d="M3.6 1.59H15.35A3.7 3.7 0 0 1 15.35 8.99H3.6" stroke="#8aa2ff" stroke-width="1.68" stroke-linejoin="round" fill="none"/><path d="M3.6 1.59H13.6A1.95 1.95 0 0 1 13.6 5.49H3.6" stroke="#5ef0c4" stroke-width="1.68" stroke-linejoin="round" fill="none"/><path d="M3.6 0.75V24.0" stroke="#f4f6fb" stroke-width="1.68" fill="none"/></svg>{' '}
    <div class="finale" id="finale">{' '}
      <h1>Toward machines with a mind of their own.</h1>{' '}
      <p class="era">New era of intelligence.</p>{' '}
      <nav aria-label="Psyche">{' '}
        <a href={withBase('what-were-building/')}>What we're building</a>{' '}
        <a href={withBase('blog/')}>Blog</a>{' '}
        <a href={withBase('about/')}>Get in touch</a>{' '}
      </nav>{' '}
    </div>{' '}
    <div class="hint" id="hint" aria-hidden="true">scroll<i></i></div>{' '}
  </div>{' '}
</main>{' '}

<section class="static" aria-label="Psyche">{' '}
  <ol>{' '}
    <li>The most powerful intelligence ever known. It starts here.</li>{' '}
    <li>Eighty-six billion neurons. Each one a tree, listening on thousands of branches.</li>{' '}
    <li>Where two of them meet, learning happens. No teacher and no master plan: a connection grows stronger each time it is used.</li>{' '}
    <li>How deep does it go? Some physicists look for the answer in quantum effects inside the cell itself. We keep that question open.</li>{' '}
    <li>Then a spike. All or nothing. The brain's own one and zero.</li>{' '}
    <li>We rebuild that pulse in a machine. Charge rises, crosses a threshold, fires.</li>{' '}
    <li>Our bet: wire thousands together, let each learn only from its neighbours, and the network draws its own map of the world.</li>{' '}
  </ol>{' '}
  <svg class="mark" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 26 24" aria-hidden="true"><path d="M3.6 1.59H17.1A5.45 5.45 0 0 1 17.1 12.49H6.84" stroke="#f4f6fb" stroke-width="1.68" stroke-linejoin="round" fill="none"/><path d="M3.6 1.59H15.35A3.7 3.7 0 0 1 15.35 8.99H3.6" stroke="#8aa2ff" stroke-width="1.68" stroke-linejoin="round" fill="none"/><path d="M3.6 1.59H13.6A1.95 1.95 0 0 1 13.6 5.49H3.6" stroke="#5ef0c4" stroke-width="1.68" stroke-linejoin="round" fill="none"/><path d="M3.6 0.75V24.0" stroke="#f4f6fb" stroke-width="1.68" fill="none"/></svg>{' '}
  <svg class="letters" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 5371 870" role="img" aria-label="Psyche"><g transform="translate(60.0 35.8) scale(32.2581)"><path d="M3.6 1.59H17.1A5.45 5.45 0 0 1 17.1 12.49H6.84" stroke="#f4f6fb" stroke-width="1.68" stroke-linejoin="round" fill="none"/><path d="M3.6 1.59H15.35A3.7 3.7 0 0 1 15.35 8.99H3.6" stroke="#8aa2ff" stroke-width="1.68" stroke-linejoin="round" fill="none"/><path d="M3.6 1.59H13.6A1.95 1.95 0 0 1 13.6 5.49H3.6" stroke="#5ef0c4" stroke-width="1.68" stroke-linejoin="round" fill="none"/><path d="M3.6 0.75V24.0" stroke="#f4f6fb" stroke-width="1.68" fill="none"/></g><g transform="translate(894.5 810.0)" fill="#f4f6fb"><path d="M43 -242H99Q107 -181 145.5 -135.0Q184 -89 247.5 -64.0Q311 -39 393 -39Q517 -39 591.0 -84.5Q665 -130 665 -209Q665 -267 616.5 -299.0Q568 -331 450 -344L323 -358Q184 -373 125.5 -422.0Q67 -471 67 -548Q67 -614 106.0 -662.0Q145 -710 214.0 -736.0Q283 -762 374 -762Q468 -762 540.5 -733.0Q613 -704 655.5 -652.0Q698 -600 702 -531H646Q640 -586 604.0 -626.0Q568 -666 509.0 -688.5Q450 -711 373 -711Q259 -711 191.0 -668.0Q123 -625 123 -548Q123 -488 171.5 -456.0Q220 -424 333 -411L454 -397Q550 -386 609.0 -364.0Q668 -342 694.5 -304.5Q721 -267 721 -211Q721 -141 680.0 -91.0Q639 -41 565.0 -14.5Q491 12 392 12Q294 12 217.0 -20.0Q140 -52 94.0 -109.5Q48 -167 43 -242Z"/><path transform="translate(848 0)" d="M382 0V-351H438V0ZM25 -750H92L436 -327H385L726 -750H793L427 -298H393Z"/><path transform="translate(1748 0)" d="M847 -280Q837 -194 785.5 -128.0Q734 -62 650.5 -25.0Q567 12 461 12Q339 12 247.0 -37.0Q155 -86 104.0 -173.5Q53 -261 53 -375Q53 -490 104.0 -577.0Q155 -664 247.0 -713.0Q339 -762 461 -762Q567 -762 650.5 -725.0Q734 -688 785.5 -622.5Q837 -557 847 -470H789Q777 -543 733.0 -597.0Q689 -651 619.0 -680.5Q549 -710 459 -710Q354 -710 275.5 -668.5Q197 -627 154.0 -552.0Q111 -477 111 -375Q111 -274 154.0 -198.5Q197 -123 275.5 -81.5Q354 -40 459 -40Q549 -40 619.0 -69.5Q689 -99 733.0 -153.0Q777 -207 789 -280Z"/><path transform=