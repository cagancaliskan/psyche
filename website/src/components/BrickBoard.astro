---
// The substrate's bricks (stage 1) as one card per build status, read from the staged public
// projection of tools/ledger.json. Nothing here is typed by hand: names, statuses and counts come
// from the ledger.
import ledger from '../data/ledger.public.json';
import '../styles/docs-visuals.css';
import '../styles/plan.css';

interface Brick {
  id: string;
  name: string;
  status: string;
}

// `status` is the ledger's own name for the group and stays as it is there. `heading` is the word a
// reader sees, and `meaning` is what the status name means in plain words where the card names it.
const groups: { status: string; tone: string; heading: string; note: string; meaning?: string; collapsed?: boolean }[] = [
  {
    status: 'PROVEN',
    tone: 'proven',
    heading: 'Verified',
    note: 'Deterministic, integrity-preserving and pure, verified in a separate tester pass.',
    meaning: 'verified by the full adversarial suite on every interpreter; not a formal proof',
  },
  { status: 'BUILT-UNVALIDATED', tone: 'built', heading: 'Built; meaning not validated', note: 'The mechanism is tester-verified; no cognitive claim is made.' },
  { status: 'NO-GO', tone: 'stopped', heading: 'Stopped before a graded run', note: 'Attempts at a cognitive claim stopped before any graded number existed, each at its own wall: a circular yardstick, or a mechanism the effect needs that the engine lacks.' },
  { status: 'DESIGNED', tone: 'designed', heading: 'Designed, not built', note: 'Specified only. Paused with the rest of the substrate.', collapsed: true },
];
const bricks = (ledger.bricks as Brick[]).slice();
const shown = new Set(groups.map((g) => g.status));
const other = bricks.filter((b) => !shown.has(b.status));
const cards = [
  ...groups.map((g) => ({ ...g, items: bricks.filter((b) => b.status === g.status) })),
  ...(other.length > 0 ? [{ status: 'OTHER', tone: 'other', heading: 'Other states', note: 'States outside the four above, as the ledger records them.', items: other }] : []),
].filter((c) => c.items.length > 0);
const slug = (s: string) => s.toLowerCase().replace(/[^a-z0-9]+/g, '-');
---

<div class="sx-bricks not-content">
  <div class="sx-bricks__grid">
    {
      cards.map((c) => {
        const list = (
          <ul class="sx-bricks__list">
            {c.items.map((b) => (
              <li>
                <code class="sx-bricks__id">{b.id}</code> <span>{c.tone === 'other' ? `${b.name} (${b.status.toLowerCase()})` : b.name}</span>
              </li>
            ))}
          </ul>
        );
        return (
          <section class="sx-bricks__card sx-spot" data-spot data-tone={c.tone} aria-labelledby={`sx-bricks-${slug(c.status)}`}>
            <div class="sx-bricks__head">
              <h3 class="sx-bricks__title" id={`sx-bricks-${slug(c.status)}`}>
                <span class="sx-bricks__dot" aria-hidden="true" />
                <span>{c.heading}</span>
              </h3>
              <p class="sx-bricks__count">
                {c.items.length} <span class="sr-only">{c.items.length === 1 ? 'brick' : 'bricks'}</span>
              </p>
            </div>
            <p class="sx-bricks__note">{c.note}</p>
            {'meaning' in c && c.meaning && (
              <p class="sx-bricks__note">
                Ledger status <code>{c.status}</code>: {c.meaning}.
              </p>
            )}
            {'collapsed' in c && c.collapsed ? (
              <details class="sx-disclosure">
                <summary>Show the list</summary>
                {list}
              </details>
            ) : (
              list
            )}
          </section>
        );
      })
    }
  </div>
</div>

<script>
  import './docs/motion.ts';
</script>
