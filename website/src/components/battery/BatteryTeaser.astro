---
// The battery rows: one hairline-ruled row per test (T1 to T5), each with its mono id, its name,
// one line and, at the right, a small picture of the step that defines it (the direct route, the
// detour, the shortcut, the shared layout, the test pair). The whole row links to its test on the
// battery page. Rendered on the server; a small script draws each route once when its row is
// seen. Used on the landing and on the Test battery docs page; the layout follows the width it
// is given. The id shares the first line of the name; the link's name is the whole visible label
// (id, name and line). The pictures are illustrations of classic paradigms, not results.
// Catalog (21st.dev): the row anatomy and the highlight bar that travels along the row follow
// "Interactive List Preview" by hyperiux, without its preview image, GSAP or pointer follow.
import '@/styles/landing/battery-rows.css';
import { TestPicture } from '@/components/battery/Pictures.tsx';
import { TESTS } from '@/lib/battery.ts';
import { withBase } from '@/lib/url.ts';

const rows = TESTS.map((test, i) => {
  const index = test.steps.length - 1;
  const slug = test.id.toLowerCase();
  return { test, i, index, slug, caption: test.steps[index].caption, href: withBase(`battery/#${slug}`) };
});
---

<div class="sx-brows-wrap not-content">
  <ol class="sx-brows" role="list" data-sx-brows>
    {
      rows.map(({ test, i, index, slug, caption, href }) => (
        <li class="sx-brow" style={`--i:${i}`} data-kind={test.kind}>
          <a class="sx-brow__link" href={href} aria-labelledby={`sx-brow-${slug}-id sx-brow-${slug}-name sx-brow-${slug}-line`}>
            <span class="sx-brow__text">
              <span class="sx-brow__id" id={`sx-brow-${slug}-id`}>{test.id}</span>{' '}
              <span class="sx-brow__head">
                <span class="sx-brow__name" id={`sx-brow-${slug}-name`}>{test.name}</span>
              </span>{' '}
              <span class="sx-brow__line" id={`sx-brow-${slug}-line`}>{caption}</span>
            </span>
            <span class="sx-brow__pic" aria-hidden="true" data-pagefind-ignore>
              <TestPicture test={test} index={index} decorative idPrefix={`sx-brow-${slug}`} />
            </span>
            <svg class="sx-brow__go" viewBox="0 0 20 20" aria-hidden="true" focusable="false">
              <path d="M4 10h11M10.5 5.5 15 10l-4.5 4.5" />
            </svg>
          </a>
        </li>
      ))
    }
  </ol>
</div>

<script>
  // Each route draws once when its row comes into view, and again on hover or keyboard focus (the
  // styles do that part). Rows without a route to draw, and reduced motion, stay as they are.
  for (const list of document.querySelectorAll<HTMLElement>('[data-sx-brows]')) {
    if (!('IntersectionObserver' in window) || !matchMedia('(prefers-reduced-motion: no-preference)').matches) continue;
    const seen = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          if (!entry.isIntersecting) continue;
          const row = entry.target as HTMLElement;
          seen.unobserve(row);
          row.removeAttribute('data-wait');
          row.setAttribute('data-draw', '');
          row.addEventListener('animationend', () => row.removeAttribute('data-draw'), { once: true });
        }
      },
      { threshold: 0.6 },
    );
    for (const row of list.querySelectorAll<HTMLElement>('.sx-brow')) {
      if (row.querySelector('.draw')) {
        row.setAttribute('data-wait', '');
        seen.observe(row);
      }
    }
  }
</script>
