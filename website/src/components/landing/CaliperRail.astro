---
// A quiet reading guide in the right page gutter (1200px and wider, fine pointer). A slim bar closes
// over the extent of the section in view, in the hue that section is about (read from its header),
// a dot shows the reading position along it and the section's name hangs beside it. A section opts
// in with data-caliper="Stages" (its name). The rail is decoration: hidden from assistive
// technology, no pointer events, no layout space, and it shows only while a marked section is in
// view.
//
// After "Scroll Caliper" by nikolas-sapa (21st.dev): the bar over the active section's extent and
// the single marker. The scale, the springs, the motion blur and the readout are left out (see
// styles/landing/caliper.css). The script below measures on scroll or resize only, once per
// animation frame, and writes nothing when the reading has not changed.
import '@/styles/landing/caliper.css';
---

<div class="sx-caliper not-content" aria-hidden="true" data-pagefind-ignore>
  <div class="sx-caliper__span"></div>
  <div class="sx-caliper__lab"></div>
  <div class="sx-caliper__mark"></div>
</div>

<script>
  const rail = document.querySelector<HTMLElement>('.sx-caliper');
  const secs = [...document.querySelectorAll<HTMLElement>('[data-caliper]')];

  if (rail && secs.length) {
    // The same query as caliper.css; below it the rail is not rendered and nothing is measured.
    const wide = matchMedia('(min-width:1200px) and (pointer:fine)');
    const clamp = (v: number, hi: number) => Math.min(hi, Math.max(0, v));
    let raf = 0;
    let at: HTMLElement | undefined;
    let last = '';
    let hue = 'violet';

    const draw = () => {
      raf = 0;
      if (!wide.matches) return;
      const rb = rail.getBoundingClientRect();
      const mid = rb.top + rb.height / 2;

      // The section the reading line (the rail's middle) is in, or the nearest one within a third of
      // the rail's height of it, so the rail wakes as a marked section comes up the page.
      let near = rb.height * 0.3;
      let cur: HTMLElement | undefined;
      let box = rb;
      for (const s of secs) {
        const r = s.getBoundingClientRect();
        const d = Math.max(r.top - mid, mid - r.bottom, 0);
        if (d < near) {
          near = d;
          cur = s;
          box = r;
        }
      }
      if (cur !== at) {
        at = cur;
        rail.classList.toggle('on', !!cur);
        if (cur) {
          // A leading number, if a caller still writes one, is not part of the name.
          rail.querySelector('.sx-caliper__lab')!.textContent = (cur.dataset.caliper ?? '').replace(/^\d+\s+/, '');
          hue = cur.querySelector<HTMLElement>('[data-hue]')?.dataset.hue ?? 'violet';
        }
      }
      if (!cur) return;

      // The bar on the section's edges, kept inside the rail; the marker sweeps from end to end as the
      // reading line moves from the section's top to its bottom.
      const a = clamp(box.top - rb.top, rb.height);
      const b = clamp(box.bottom - rb.top, rb.height);
      const m = a + clamp((mid - box.top) / (box.height || 1), 1) * (b - a);
      const css = `--hue:var(--sx-${hue});--a:${a.toFixed(1)}px;--g:${(b - a).toFixed(1)};--m:${m.toFixed(1)}px`;
      if (css !== last) rail.style.cssText = last = css;
    };

    const run = () => {
      if (!raf) raf = requestAnimationFrame(draw);
    };
    addEventListener('scroll', run, { passive: true });
    // Fires once at start, and again when the page changes height or width.
    new ResizeObserver(run).observe(document.documentElement);
    wide.addEventListener('change', run);
  }
</script>
