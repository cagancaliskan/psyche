---
// A landing section's opening: a kicker (a legend entry: a square swatch in the hue the section is
// about, then its name; after "Tagline" by shadcncraft, 21st.dev), then the display heading rising
// out of a clip once in view (after "Text Reveal (Mask)" by soralabs, 21st.dev, in plain CSS and a
// few lines of script, without its motion library) and at most one short lead in the default slot.
// The kicker repeats the heading, so assistive technology skips it. The server markup is the
// finished frame: only below the fold, with script and without reduced motion, a header waits until
// it scrolls into view. Styles are in src/styles/landing/section-header.css.
import '@/styles/landing/section-header.css';

type Hue = 'agent' | 'structure' | 'violet' | 'spike';

interface Props {
  id: string;
  title: string;
  /** A one- or two-word name for the kicker. */
  kicker?: string;
  /** The hue of the kicker's dot; by default taken from what the kicker names. */
  hue?: Hue;
}
// What each section is about: mint is stage 1, blue is stage 2 and its structure, violet is the
// project as a whole.
const hues: Record<string, Hue> = { Substrate: 'agent', Battery: 'structure', Roadmap: 'structure' };
const { id, title, kicker, hue = hues[kicker ?? ''] ?? 'violet' } = Astro.props;
---

<header class="sx-sh" data-sh data-hue={hue}>
  {kicker && <p class="sx-sh__kicker" aria-hidden="true">{kicker}</p>}
  <h2 class="sx-sh__title" id={id}><span class="sx-sh__clip"><span>{title}</span></span></h2>
  <slot />
</header>

<script>
  // Headers below the fold wait, then rise once as they come into view; those already on screen are
  // never hidden. One shared observer serves every header on the page.
  const heads = [...document.querySelectorAll<HTMLElement>('[data-sh]')];
  if (heads.length > 0 && 'IntersectionObserver' in window && matchMedia('(prefers-reduced-motion: no-preference)').matches) {
    const seen = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          if (!entry.isIntersecting) continue;
          seen.unobserve(entry.target);
          (entry.target as HTMLElement).dataset.sh = 'in';
        }
      },
      { rootMargin: '0px 0px -12% 0px' },
    );
    for (const head of heads) {
      if (head.getBoundingClientRect().top < innerHeight) continue;
      head.dataset.sh = 'wait';
      seen.observe(head);
    }
    addEventListener('beforeprint', () => heads.forEach((head) => (head.dataset.sh = 'in')));
  }
</script>
