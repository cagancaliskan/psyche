---
// The T1 latent-learning picture in one frame: the exploration trail, then the direct route to a
// goal introduced afterwards. Paths only. Drawn by the battery's own GridPicture, on the server.
import { GridPicture } from '@/components/battery/Pictures.tsx';
import { TESTS, type GridStep } from '@/lib/battery.ts';

const t1 = TESTS.find((t) => t.id === 'T1');
if (!t1 || t1.kind !== 'grid') throw new Error('battery test T1 is missing or not a grid picture');
const explored = t1.steps.find((s) => s.trail);
const last = t1.steps[t1.steps.length - 1];
if (!explored?.trail || !last.path || !last.start || !last.goal) throw new Error('battery test T1 lacks a trail, route, start or goal');

const step: GridStep = {
  ...last,
  trail: explored.trail,
  caption: "Illustration: an agent's trail through a small maze without reward, then the direct route to a goal introduced afterwards.",
};
const paradigm = t1.paradigm.charAt(0).toLowerCase() + t1.paradigm.slice(1);
---

<figure class="sx-lp-maze">
  <div class="sx-lp-maze__frame">
    <GridPicture step={step} />
  </div>
  <figcaption>{t1.id}, {t1.name.toLowerCase()}, {paradigm}: explore without reward, then reach a goal introduced afterwards. An illustration, not a result.</figcaption>
</figure>
