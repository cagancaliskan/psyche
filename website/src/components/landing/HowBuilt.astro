---
// Layout after "Bento Feature Grid" by ln-dev7 (21st.dev).
import { Columns3, Grid3x3, ScrollText, Swords } from 'lucide-react';
import ledger from '@/data/ledger.public.json';
import type { PublicLedger } from '@/lib/ledger.ts';
import { withBase } from '@/lib/url.ts';
import SectionHeader from './SectionHeader.astro';

const { determinism } = ledger as unknown as PublicLedger;

const tiles = [
  {
    icon: ScrollText,
    label: 'One ledger',
    body: 'Every count and status lives in one ledger. A check runs in CI and fails when a document disagrees with it.',
  },
  {
    icon: Columns3,
    label: 'Separate lanes',
    body: 'A builder implements test-first, a tester attacks the work independently, and a validator tests any cognitive claim against external data. The lanes do not cross.',
  },
  {
    icon: Swords,
    label: 'Adversarial and loop-closed tests',
    body: 'Tester suites are hostile and written apart from the code they attack. Each part is driven with input generated by the part before it, never a friendly hand-picked case.',
  },
  {
    icon: Grid3x3,
    label: `Determinism across ${determinism.interpreters.length} interpreters and ${determinism.hash_seeds.length} hash seeds`,
    body: 'Every registered suite runs on each CPython version under each hash seed. A property that holds on one interpreter only was never a property of the program.',
  },
];
---

<section class="sx-lp-section not-content" aria-labelledby="sx-built-title">
  <SectionHeader id="sx-built-title" title="How the work is built">
    <p>The method came with the substrate and carries into every stage.</p>
  </SectionHeader>
  <ul class="sx-lp-plain grid grid-cols-1 gap-4 sm:grid-cols-2">
    {
      tiles.map(({ icon: Icon, label, body }) => (
        <li class="flex flex-col gap-5 rounded-2xl border border-border bg-card p-6 sm:p-8">
          <div class="grid size-10 place-items-center rounded-xl border border-border bg-paper text-sx-structure">
            <Icon className="size-5" strokeWidth={1.5} aria-hidden="true" />
          </div>
          <div>
            <h3 class="text-xl leading-snug text-ink text-balance">{label}</h3>
            <p class="mt-1.5 text-[0.95rem] leading-relaxed text-muted-foreground text-pretty">{body}</p>
          </div>
        </li>
      ))
    }
  </ul>
  <p class="sx-lp-more">Read the <a class="sx-lp-a" href={withBase('research/engineering/')}>engineering standards</a> and the substrate's <a class="sx-lp-a" href={withBase('substrate/methodology/')}>methodology</a>.</p>
</section>
