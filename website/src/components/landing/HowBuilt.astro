---
// How the work is built: a bento of four method tiles, each with a small static diagram. Layout
// after "Bento Feature Grid" by ln-dev7, cards with the spotlight of "Spotlight" by kevingirelli
// (both 21st.dev). The diagrams are decorative; each tile's text says the same in words.
import { Columns3, Grid3x3, ScrollText, Swords } from 'lucide-react';
import ledger from '@/data/ledger.public.json';
import type { PublicLedger } from '@/lib/ledger.ts';
import { withBase } from '@/lib/url.ts';
import SectionHeader from './SectionHeader.astro';

const { determinism } = ledger as unknown as PublicLedger;
const lanes = ['builder', 'tester', 'validator'];
const parts = ['P1', 'P2', 'P3'];
---

<section class="sx-lp-section not-content" aria-labelledby="sx-built-title">
  <SectionHeader id="sx-built-title" title="How the work is built" index="04" kicker="Method">
    <p>The method came with the substrate and carries into every stage.</p>
  </SectionHeader>
  <ul class="sx-lp-plain sx-bento">
    <li class="sx-card sx-bento__tile sx-bento__tile--wide" data-reveal>
      <div class="sx-dg sx-dg--ledger" aria-hidden="true">
        <div class="sx-dg__docs">
          <span class="sx-dg__doc"></span>
          <span class="sx-dg__doc"></span>
          <span class="sx-dg__doc"></span>
          <span class="sx-dg__doc"></span>
        </div>
        <svg class="sx-dg__fan" viewBox="0 0 100 100" preserveAspectRatio="none" focusable="false">
          <path d="M0 12.5C55 12.5 45 50 100 50M0 37.5C55 37.5 45 50 100 50M0 62.5C55 62.5 45 50 100 50M0 87.5C55 87.5 45 50 100 50"></path>
        </svg>
        <span class="sx-dg__node sx-dg__node--ledger">ledger</span>
        <span class="sx-dg__wire"></span>
        <span class="sx-dg__node sx-dg__node--check">
          <svg viewBox="0 0 24 24" focusable="false"><path d="M5 12.5l4.5 4.5L19 7.5"></path></svg>
          CI
        </span>
      </div>
      <div class="sx-bento__text">
        <h3><ScrollText className="sx-bento__icon" strokeWidth={1.5} aria-hidden="true" /> One ledger</h3>
        <p>Every count and status lives in one ledger. A check runs in CI and fails when a document disagrees with it.</p>
      </div>
    </li>
    <li class="sx-card sx-bento__tile" data-reveal>
      <div class="sx-dg sx-dg--lanes" aria-hidden="true">
        {
          lanes.map((lane) => (
            <div class="sx-dg__lane">
              <span class="sx-dg__lane-name">{lane}</span>
              <span class="sx-dg__lane-line">
                <i />
                <i />
                <i />
              </span>
            </div>
          ))
        }
      </div>
      <div class="sx-bento__text">
        <h3><Columns3 className="sx-bento__icon" strokeWidth={1.5} aria-hidden="true" /> Separate lanes</h3>
        <p>A builder implements test-first, a tester attacks the work independently, and a validator tests any cognitive claim against external data. The lanes do not cross.</p>
      </div>
    </li>
    <li class="sx-card sx-bento__tile" data-reveal>
      <div class="sx-dg sx-dg--chain" aria-hidden="true">
        <div class="sx-dg__chain">
          {
            parts.map((part, i) => (
              <>
                {i > 0 && <span class="sx-dg__arrow" />}
                <span class="sx-dg__box">{part}</span>
              </>
            ))
          }
        </div>
        <div class="sx-dg__probe">
          <span class="sx-dg__probe-line"></span>
          <span class="sx-dg__probe-name">tester</span>
        </div>
      </div>
      <div class="sx-bento__text">
        <h3><Swords className="sx-bento__icon" strokeWidth={1.5} aria-hidden="true" /> Adversarial and loop-closed tests</h3>
        <p>Tester suites are hostile and written apart from the code they attack. Each part is driven with input generated by the part before it.</p>
      </div>
    </li>
    <li class="sx-card sx-bento__tile sx-bento__tile--wide" data-reveal>
      <div class="sx-dg sx-dg--axes" aria-hidden="true">
        <div class="sx-dg__axis">
          <span class="sx-dg__axis-name">CPython</span>
          <span class="sx-dg__chips">{determinism.interpreters.map((v) => <span>{v}</span>)}</span>
        </div>
        <span class="sx-dg__times">&times;</span>
        <div class="sx-dg__axis">
          <span class="sx-dg__axis-name">Hash seed</span>
          <span class="sx-dg__chips">{determinism.hash_seeds.map((s) => <span>{s}</span>)}</span>
        </div>
      </div>
      <div class="sx-bento__text">
        <h3>
          <Grid3x3 className="sx-bento__icon" strokeWidth={1.5} aria-hidden="true" />
          {` Determinism across ${determinism.interpreters.length} interpreters and ${determinism.hash_seeds.length} hash seeds`}
        </h3>
        <p>Every registered suite runs on each CPython version under each hash seed. A property that holds on one interpreter only was never a property of the program.</p>
      </div>
    </li>
  </ul>
  <p class="sx-lp-more" data-reveal>Read the <a class="sx-lp-a" href={withBase('research/engineering/')}>engineering standards</a> and the substrate's <a class="sx-lp-a" href={withBase('substrate/methodology/')}>methodology</a>.</p>
</section>
