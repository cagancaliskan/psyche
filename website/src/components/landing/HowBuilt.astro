---
// How the work is built: four numbered rows ruled by hairlines (a mono index, a title, a
// sentence), no icons and no diagrams. The ruled rhythm follows "Spec Sheet" by isaiahbjork
// (21st.dev); the section-end links are in styles/landing/links.css. The determinism row reads
// its counts from the public ledger.
import ledger from '@/data/ledger.public.json';
import type { PublicLedger } from '@/lib/ledger.ts';
import { withBase } from '@/lib/url.ts';
import SectionHeader from './SectionHeader.astro';
import '@/styles/landing/rows.css';
import '@/styles/landing/links.css';

const { determinism } = ledger as unknown as PublicLedger;

// The section's place on the page; the rows are numbered under it (04.1, 04.2, ...).
const section = '04';
const rows = [
  {
    title: 'One ledger',
    text: 'Every count and status lives in one ledger. A check runs in CI and fails when a document disagrees with it.',
  },
  {
    title: 'Separate lanes',
    text: 'A builder implements test-first, a tester attacks the work independently, and a validator tests any cognitive claim against external data. The lanes do not cross.',
  },
  {
    title: 'Adversarial and loop-closed tests',
    text: 'Tester suites are hostile and written apart from the code they attack. Each part is driven with input generated by the part before it.',
  },
  {
    title: `Determinism across ${determinism.interpreters.length} interpreters and ${determinism.hash_seeds.length} hash seeds`,
    text: 'Every registered suite runs on each CPython version under each hash seed. A property that holds on one interpreter only was never a property of the program.',
  },
];
---

<section class="sx-lp-section not-content" aria-labelledby="sx-built-title" data-caliper="04 Method">
  <SectionHeader id="sx-built-title" title="How the work is built" index={section} kicker="Method">
    <p>The method came with the substrate and carries into every stage.</p>
  </SectionHeader>
  <ol class="sx-ruled sx-ruled--method" role="list">
    {
      rows.map((row, i) => (
        <li class="sx-ruled__row" data-reveal>
          <span class="sx-ruled__idx" aria-hidden="true">{section}.{i + 1}</span>
          <h3 class="sx-ruled__title">{row.title}</h3>
          <p class="sx-ruled__text">{row.text}</p>
        </li>
      ))
    }
  </ol>
  <p class="sx-lp-links" data-reveal>
    <a class="sx-lp-link" href={withBase('research/engineering/')}>Read the engineering standards</a>
    <a class="sx-lp-link" href={withBase('substrate/methodology/')}>Read the substrate's methodology</a>
  </p>
</section>
