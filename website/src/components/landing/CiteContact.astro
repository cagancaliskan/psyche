---
// How to cite Psyche and how to reach the project: the landing's closing section, one flat panel
// with a violet edge (the project as a whole) holding two parts in a definition list, each a label and
// what to do, with its links as buttons. The structure, a definition list of label and value pairs that
// stacks on a narrow screen, follows "Key Value List" by corr (21st.dev), without its rounded border,
// truncation or colour classes; the outlined button (class sx-pill) is the landing's own
// (styles/landing/rows.css) and the panel's layout is styles/landing/cite.css.
//
// The citation is the preferred citation of CITATION.cff at the repository root, in the form the README
// and docs/PSYCHE.md print it: the archived report of stage 1 on Zenodo, with its DOI as the link, and the
// note that its title uses the project's earlier name. It is typed here, not read, because the file is not
// part of the site's build; the DOI in this component must stay equal to the one in CITATION.cff, which
// test_cited_doi in tools/publish/test_core.py checks (it also checks the Discussions link below).
// The contact route is the repository's GitHub Discussions, the one the footer links too. There is
// no email address.
import { REPO_URL } from '@/lib/seo.ts';
import { withBase } from '@/lib/url.ts';
import SectionHeader from './SectionHeader.astro';
import '@/styles/landing/rows.css';
import '@/styles/landing/cite.css';

// preferred-citation in CITATION.cff.
const cite = {
  author: 'Caliskan, C.',
  year: '2026',
  title: 'Nous: Adversarial Testing of a Dependency-Free Memory-and-Activation Substrate for Cognitive Architectures',
  publisher: 'Zenodo',
  doi: '10.5281/zenodo.20474613',
  note: "The archived title uses the project's earlier name; the project is Psyche.",
};
const doiUrl = `https://doi.org/${cite.doi}`;
---

<section class="sx-lp-section not-content" id="cite" aria-labelledby="sx-cite-title" data-caliper="Cite">
  <SectionHeader id="sx-cite-title" title="Cite and contact" kicker="Cite">
    <p>New to Psyche? <a class="sx-lp-a" href={withBase('guide/')}>The Reader's guide</a> is the place to begin.</p>
  </SectionHeader>
  <dl class="sx-cite" data-reveal>
    <div class="sx-cite__part">
      <dt class="sx-cite__k">Cite</dt>
      <dd class="sx-cite__v">
        <p class="sx-cite__lead">To cite Psyche today, cite the archived report of its first stage.</p>
        <p class="sx-cite__ref">{cite.author} ({cite.year}). <cite>{cite.title}.</cite> {cite.publisher}.</p>
        <p class="sx-cite__note">{cite.note}</p>
        <a class="sx-pill" href={doiUrl}>{doiUrl}</a>
      </dd>
    </div>
    <div class="sx-cite__part sx-cite__part--contact">
      <dt class="sx-cite__k">Contact</dt>
      <dd class="sx-cite__v">
        <p class="sx-cite__lead">To ask a question or raise a point, write in GitHub Discussions on the repository.</p>
        <a class="sx-pill sx-pill--primary" href={`${REPO_URL}/discussions`}>Open GitHub Discussions</a>
      </dd>
    </div>
  </dl>
</section>
