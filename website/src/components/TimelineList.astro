---
// The research roadmap as an ordered list: the narrow-screen form of the timeline. It shows only
// where the timeline has too little width (see .sx-tll in plan.css). The gate the line is waiting
// on is read from the plan's own as_of date, so the HTML stays deterministic; a small script then
// moves the mark and the wording to the reader's today (lib/gateClock.ts), so a gate past its date
// with no recorded decision reads "decision pending" here as it does in the timeline.
import { formatDay, gateNote, gateState, lineStoppedAt, nextGate, phaseWhen, type Plan } from '../lib/plan.ts';
import '../styles/plan.css';

interface Props {
  plan: Plan;
}
const { plan } = Astro.props;
const gates = new Map(plan.gates.map((g) => [g.id, g]));
const next = nextGate(plan, plan.as_of)?.id ?? null;
const stoppedAt = lineStoppedAt(plan)?.id ?? null;
const label = (s: string) => s.charAt(0).toUpperCase() + s.slice(1);
---

<div class="sx-tll-wrap not-content" data-gate-list data-tz={plan.timezone}>
  <ol class="sx-tll" aria-label="Research phases in order">
    {
      plan.phases.map((p) => {
        const g = p.gate ? gates.get(p.gate) : undefined;
        const state = g ? gateState(g, plan.as_of, stoppedAt) : undefined;
        const note = g && state ? gateNote(g, state) : null;
        return (
          <li class="sx-tll__item" data-status={p.status} data-open={p.start === null || p.end === null ? 'true' : 'false'}>
            <span class="sx-tll__mark" aria-hidden="true" />
            <p class="sx-tll__head">
              <span class="sx-tll__id">{p.id}</span> <strong>{p.title}</strong>
            </p>
            <p class="sx-tll__when">
              <span>{phaseWhen(p)}</span> <span class="sx-chip" data-tone={p.status === 'active' ? 'now' : p.status}>{label(p.status)}</span>
            </p>
            {g && (
              <p
                class="sx-tll__gate"
                data-gate-id={g.id}
                data-state={g.status}
                data-date={g.date ?? ''}
                data-decided-on={g.decided_on ?? ''}
                data-next-step={g.next_step ?? ''}
              >
                <span class="sx-diamond" data-gate-mark data-gate-state={state?.kind} data-next={g.id === next ? '' : undefined} aria-hidden="true" />
                <span>
                  Gate {g.id} ({g.title}): {g.date ? formatDay(g.date) : g.date_rule}{' '}
                  <span class="sx-tll__note" data-gate-note hidden={note === null}>{note}</span>
                </span>
              </p>
            )}
          </li>
        );
      })
    }
  </ol>
</div>

<script>
  import { applyGateClock } from '../lib/gateClock.ts';

  for (const root of document.querySelectorAll<HTMLElement>('[data-gate-list]')) applyGateClock(root);
</script>
