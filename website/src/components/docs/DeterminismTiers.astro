---
// The three determinism tiers of the Engineering page, in that page's own words: the guarantee,
// what each tier applies to and how it is checked. Drawn as a ruled sheet, one row per tier, the
// strongest first, with a three-cell gauge on a scale that runs from the weakest tier to the
// strongest (the idea of a ruled scale with major marks and labels, after "Marks Slider" by ai2
// and "Leaderboard Bars" by eugeneshilow on 21st.dev; none of their code). The gauge shows only
// the order of strength the page states (a result built from tiers states the weakest of them):
// the cells filled count the tier's place on the scale, and the scale is labelled once, under the
// first row, with the tiers' own letters, as a ruler is marked once, so the order reads without
// colour. The labels are drawn by the stylesheet.
import Figure from './Figure.astro';

const tiers = [
  {
    id: 'A',
    strength: 3,
    guarantee: 'Bit-exact across CPython versions and hash seeds',
    applies: 'Environments, battery, metrics, counters',
    checked: 'Outputs from fresh interpreter processes, under each supported CPython version and several hash seeds, compared byte for byte',
  },
  {
    id: 'B',
    strength: 2,
    guarantee: 'Bit-exact on CPU for one pinned version, with deterministic algorithms enabled in the deep-learning framework',
    applies: 'CPU runs',
    checked: 'Deterministic algorithms are enabled where the framework provides them; where it does not, this is documented and the result does not claim tier B',
  },
  {
    id: 'C',
    strength: 1,
    guarantee: 'Statistical reproducibility',
    applies: 'GPU runs',
    checked: 'Fixed seeds; results reported with confidence intervals over seeds',
  },
];
// The scale, weakest to strongest, left to right: one cell for each tier, named by its letter.
const scale = [...tiers].sort((a, b) => a.strength - b.strength);
---

<Figure
  kicker="Determinism tiers"
  lead="Not every computation can be made bit-exact, so each reported result states its tier. A result built from parts at different tiers states the weakest of them."
>
  <ol class="sx-tiers" aria-label="Determinism tiers, strongest first">
    {
      tiers.map((t, row) => (
        <li class="sx-tier">
          <div class="sx-tier__id">
            <p class="sx-tier__letter">
              <span class="sr-only">Tier </span>
              {t.id}
            </p>
            <span class="sx-gauge" aria-hidden="true">
              {scale.map((cell) => (
                <span data-l={row === 0 ? cell.id : undefined} data-on={cell.strength <= t.strength ? '' : undefined} />
              ))}
            </span>
          </div>
          <div>
            <p class="sx-tier__guarantee">{t.guarantee}</p>
            <dl>
              <div>
                <dt class="sx-kicker">Applies to</dt>
                <dd>{t.applies}</dd>
              </div>
              <div>
                <dt class="sx-kicker">How it is checked</dt>
                <dd>{t.checked}</dd>
              </div>
            </dl>
          </div>
        </li>
      ))
    }
  </ol>
</Figure>
