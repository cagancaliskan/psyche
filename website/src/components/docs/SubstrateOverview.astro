---
// The substrate overview's header: the captured test run as the landing's readout, drawn as a sheet,
// then the layer stack.
import LayerStack from './LayerStack.astro';
import SubstrateReadout from '@/components/landing/SubstrateReadout.astro';
import ledger from '@/data/ledger.public.json';
import type { PublicLedger } from '@/lib/ledger.ts';
import { substrateReadout } from '@/lib/status.ts';

// Every number in the readout is read from the ledger projection.
const stats = substrateReadout(ledger as unknown as PublicLedger);
---

<SubstrateReadout items={stats} framed />
<LayerStack />
