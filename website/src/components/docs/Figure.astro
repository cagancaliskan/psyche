---
// The frame every docs visual sits in: a mono kicker, an optional one-line lead, then the figure.
// `bare` drops the panel for figures whose parts are cards already; `beams` lets motion.ts play
// the one-pass light along the figure's connectors.
import '@/styles/docs-visuals.css';

interface Props {
  kicker: string;
  lead?: string;
  bare?: boolean;
  beams?: boolean;
  class?: string;
}
const { kicker, lead, bare = false, beams = false, class: extra } = Astro.props;
---

<figure class:list={['sx-dv', { 'sx-dv--bare': bare }, extra]} data-sx-beams={beams ? '' : undefined}>
  <figcaption class="sx-dv__cap">
    <span class="sx-kicker"><span class="sx-kicker__index" aria-hidden="true">Fig.</span> {kicker}</span>
    {lead && <span class="sx-dv__lead">{lead}</span>}
  </figcaption>
  <slot />
</figure>

<script>
  import './motion.ts';
</script>
