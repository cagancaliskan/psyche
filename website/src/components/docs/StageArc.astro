---
// The stage arc of the Origins page: stage 1, the substrate, hands its method, tooling and one
// lesson to stage 2, spiking cognitive maps; later stages toward the long-term aim build on the
// same method and are not specified yet. Each stage's state and date are read from the ledger
// projection; nothing here is typed by hand.
import Figure from './Figure.astro';
import ledger from '@/data/ledger.public.json';
import { stateLabel, type PublicLedger } from '@/lib/ledger.ts';
import { formatDay } from '@/lib/plan.ts';

const led = ledger as unknown as PublicLedger;
const sub = led.program.substrate;
const maps = led.program.cognitive_map;

const stages = [
  {
    mark: '1',
    state: sub.state,
    kicker: 'Stage 1',
    title: 'The substrate',
    text: 'A dependency-free Python memory-and-activation substrate. Its lower layers are proven correct and deterministic; it makes no cognitive claim.',
    status: `${stateLabel(sub.state)} since ${formatDay(sub.since)}`,
    via: 'Method, tooling and one lesson',
  },
  {
    mark: '2',
    state: maps.state,
    kicker: 'Stage 2',
    title: 'Spiking cognitive maps',
    text: 'Classic behavioural tests with published protocols, and baselines checked against their papers: built around the external yardstick from the start.',
    status: `${stateLabel(maps.state)} since ${formatDay(maps.since)}`,
    via: 'The same method',
  },
  {
    mark: '…',
    state: 'later',
    kicker: 'Later stages',
    title: 'Toward AGI',
    text: "The project's long-term aim, named only as an aim. Later stages will build on the same method and the project's own designs.",
    status: 'Not specified yet',
    via: null,
  },
];
---

<Figure kicker="Stage arc" lead="What links the stages is method and the lesson about evidence, not code." beams class="sx-arc">
  <ol class="sx-seq" style="--n: 3" data-via aria-label="Stages of Psyche, in order">
    {
      stages.map((s, i) => (
        <li class="sx-seq__item" data-state={s.state} aria-current={s.state === 'active' ? 'step' : undefined}>
          <div class="sx-seq__track" aria-hidden="true">
            <span class="sx-seq__mark">{s.mark}</span>
            <span class="sx-rail" data-style={i === 1 ? 'dashed' : undefined} style={`--i: ${i}`}>
              <span class="sx-rail__pulse" />
            </span>
          </div>
          <div class="sx-seq__body">
            <div class="sx-spot" data-spot>
              <p class="sx-kicker">{s.kicker}</p>
              <p class="sx-seq__title">{s.title}</p>
              <p class="sx-seq__text">{s.text}</p>
              <p class="sx-arc__state">{s.status}</p>
            </div>
          </div>
          {s.via && <p class="sx-seq__via">{s.via}</p>}
        </li>
      ))
    }
  </ol>
</Figure>
