---
// The release flow of the Disclosure policy page, step by step as that page states it: the
// private head is never released; an older tagged version that the head has moved well past goes
// through the allowlist and the scans, then the author's review of the full diff, and only then
// reaches this repository. A failed scan or a review that does not approve stops it.
import Figure from './Figure.astro';

const steps = [
  { tag: 'Private', title: 'Private head', text: 'Current work, never released', state: 'private' },
  { tag: 'Private', title: 'Tagged older version', text: 'Complete and working', state: 'private' },
  { tag: 'Check', title: 'Lag', text: 'The head has moved well past it', state: undefined },
  { tag: 'Check', title: 'Allowlist and scans', text: 'Withheld terms, secrets, tests', state: undefined },
  { tag: 'Check', title: 'Review', text: 'The author reads the full diff', state: undefined },
  { tag: 'Public', title: 'Public', text: 'In this repository', state: 'open' },
];
const pad = (n: number) => String(n).padStart(2, '0');
---

<Figure
  kicker="Release flow"
  lead="Publish complete, working, older versions. Never the current state."
  beams
>
  <ol class="sx-seq sx-flow" style="--n: 6; --gap: 0.75rem" aria-label="Release steps, in order">
    {
      steps.map((s, i) => (
        <li class="sx-seq__item" data-state={s.state}>
          <div class="sx-seq__track" aria-hidden="true">
            <span class="sx-seq__mark">{pad(i + 1)}</span>
            <span class="sx-rail" style={`--i: ${i}`}>
              <span class="sx-rail__pulse" />
            </span>
          </div>
          <div class="sx-seq__body">
            <span class="sx-kicker sx-flow__tag">{s.tag}</span>
            <p class="sx-seq__title">{s.title}</p>
            <p class="sx-seq__text">{s.text}</p>
          </div>
        </li>
      ))
    }
  </ol>
  <p class="sx-flow__stop">
    <span class="sx-kicker">Stop</span>
    <span>A failed scan, or a review that does not approve, stops the release. Nothing is stripped automatically to make it pass.</span>
  </p>
</Figure>
