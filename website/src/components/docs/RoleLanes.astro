---
// The four roles a brick moves through, in the order the contributing guide gives them, as one
// step each: the architect-pm writes the spec, the builder implements it test-first, the tester
// attacks it, and the validator runs the pre-registered experiment when a cognitive claim is
// involved; the architect-pm then folds the result into the roadmap and the ledger. Drawn as ruled
// rows (styles/docs-visuals.css): a numbered square on a rail, the role as a mono label, then what
// the role does.
import Figure from './Figure.astro';

const lanes = [
  {
    role: 'architect-pm',
    act: 'Writes the spec',
    detail: 'Turns direction into a sequenced spec with an external "done means". Changes documents only, never production code or tests.',
  },
  {
    role: 'builder',
    act: 'Implements it test-first',
    detail: 'Self-audits against the bug checklist and submits a change only when the whole suite passes on every interpreter.',
  },
  {
    role: 'tester',
    act: 'Attacks it',
    detail: 'Hostile, loop-closed suites written separately from the code they attack. Verifies mechanism, not meaning, and never modifies production code.',
  },
  {
    role: 'validator',
    act: 'Runs the pre-registered experiment, when a cognitive claim is involved',
    detail: 'A falsifiable experiment against external data. Verifies meaning, not mechanism, and never patches the module under test.',
    when: true,
  },
  {
    role: 'architect-pm',
    act: 'Folds the result into the roadmap and the ledger',
    detail: null,
  },
];
const pad = (n: number) => String(n).padStart(2, '0');
---

<Figure kicker="Roles" lead="Lanes do not cross; the separation is the evidence.">
  <ol class="sx-seq sx-lanes" aria-label="The order a brick moves through the roles">
    {
      lanes.map((l, i) => (
        <li class="sx-seq__item" data-when={l.when ? '' : undefined}>
          <div class="sx-seq__track" aria-hidden="true">
            <span class="sx-seq__mark">{pad(i + 1)}</span>
          </div>
          <div class="sx-seq__body">
            <p class="sx-kicker sx-lane__role">{l.role}</p>
            <p class="sx-lane__act">{l.act}</p>
            {l.detail && <p class="sx-lane__detail">{l.detail}</p>}
          </div>
        </li>
      ))
    }
  </ol>
</Figure>
