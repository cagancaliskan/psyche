---
// Page title for every Starlight page. Above Starlight's title, a ruled strip, as the head of a
// drawing sheet. A page of a stage opens with the stage and its section ("Stage 1  Substrate") and
// ends with the stage's state, read from the public ledger projection ("Active", "Paused since ...");
// a page outside the stages opens with the sidebar's number for its group ("01  Start here"); the 404
// page says "Error 404 ... Not filed". The stage number and the sidebar's group number are never
// printed together: they are different numbers. Nothing is typed per page: lib/pageChrome.ts reads the
// sidebar Starlight built for the page and the ledger. Structure after the eyebrow, status and rule of
// "Page Header with Breadcrumbs" by olewandowski1 (21st.dev), drawn here as a hairline strip in mono
// with no badge. Docs pages listed in ../docs/visuals.ts also get a visual header under the title,
// read by the route id Starlight resolves. This file sits with the other chrome, outside the
// folders that date /roadmap/ and /status/ (scripts/sitemap-lastmod.mjs), so a change to the strip
// moves no page's date.
import Default from '@astrojs/starlight/components/PageTitle.astro';
import ledger from '../../data/ledger.public.json';
import type { PublicLedger } from '../../lib/ledger.ts';
import { titleStrip } from '../../lib/pageChrome.ts';
import { routeOf } from '../../lib/seo.ts';
import { visualFor } from '../docs/visuals.ts';

const route = Astro.locals.starlightRoute;
const Visual = visualFor(route.id);
// The route as the address says it: the 404 page has no entry id of its own.
const here = routeOf(Astro.url.pathname);
const strip = titleStrip(here, route.sidebar, ledger as unknown as Pick<PublicLedger, 'program'>);
---

{
  strip && (
    <div class="sx-pt not-content" data-pagefind-ignore>
      <p class="sx-pt__section">
        <span class="sx-pt__idx" aria-hidden={strip.start.decorative ? 'true' : undefined}>{strip.start.tag}</span>{' '}
        {strip.start.name}
      </p>
      {strip.end && (
        <p class="sx-pt__stage" data-state={strip.end.state ?? undefined}>
          {strip.end.state ?? strip.end.text}
          {strip.end.since && (
            <>
              {' '}since <time datetime={strip.end.since.iso}>{strip.end.since.label}</time>
            </>
          )}
        </p>
      )}
    </div>
  )
}
<Default />
{
  Visual && (
    <div class="not-content sx-dv-slot">
      <Visual />
    </div>
  )
}
