---
// The decision gates in order, each with its date or the rule that will set it, its status, the
// question it decides and what happens if it is missed. The gate the line is waiting on is marked
// in spike amber from the plan's as_of date at build time. A gate past its date with no recorded
// decision reads "decision pending" and stays the marked one; a decided gate reads "decided" with
// the day it was decided and the next step, and nothing more (D-034). A small script moves the
// mark and the wording to match the reader's today (lib/gateClock.ts).
import { formatDay, gateLabel, gateNote, gateState, lineStoppedAt, nextGate, type Plan } from '../lib/plan.ts';
import '../styles/docs-visuals.css';
import '../styles/plan.css';

interface Props {
  plan: Plan;
}
const { plan } = Astro.props;
const next = nextGate(plan, plan.as_of)?.id ?? null;
const stoppedAt = lineStoppedAt(plan)?.id ?? null;
const label = (s: string) => s.charAt(0).toUpperCase() + s.slice(1);
---

<div class="sx-gs-wrap not-content" data-gate-stepper data-tz={plan.timezone}>
  <ol class="sx-gs" aria-label="Decision gates in order">
    {
      plan.gates.map((g) => {
        const isNext = g.id === next;
        const moved = g.date !== null && g.baseline_date !== null && g.date !== g.baseline_date;
        const state = gateState(g, plan.as_of, stoppedAt);
        const chip = gateLabel(state);
        const note = gateNote(g, state);
        return (
          <li
            class="sx-gs__item"
            data-gate-id={g.id}
            data-gate-current
            data-gate-state={state.kind}
            data-state={g.status}
            data-date={g.date ?? ''}
            data-decided-on={g.decided_on ?? ''}
            data-next-step={g.next_step ?? ''}
            data-next={isNext ? '' : undefined}
            aria-current={isNext ? 'step' : undefined}
          >
            <div class="sx-gs__rail" aria-hidden="true">
              <span class="sx-gs__mark">{g.id}</span>
              <span class="sx-gs__line" />
            </div>
            <article class="sx-gs__card sx-spot" data-spot>
              <h3>Gate {g.id}: {g.title}</h3>
              <p class="sx-gs__meta">
                <span class="sx-gs__when">
                  {g.date ? <time datetime={g.date}>{formatDay(g.date)}</time> : label(g.date_rule ?? 'date not yet fixed')}
                  {moved && <span> (moved from {formatDay(g.baseline_date!)})</span>}
                </span>{' '}
                <span class="sx-chip" data-tone={chip.tone} data-gate-chip>{chip.text}</span> <span class="sx-chip" data-tone="next" data-next-chip hidden={!isNext}>Next</span>
              </p>
              <p class="sx-gs__note" data-gate-note hidden={note === null}>{note}</p>
              <p class="sx-gs__question">{g.question}</p>
              <details class="sx-gs__miss sx-disclosure">
                <summary>If missed</summary>
                <p>{g.if_missed}</p>
              </details>
            </article>
          </li>
        );
      })
    }
  </ol>
</div>

<script>
  import { applyGateClock } from '../lib/gateClock.ts';
  import './docs/motion.ts';

  for (const root of document.querySelectorAll<HTMLElement>('[data-gate-stepper]')) applyGateClock(root);
</script>
