{
  "name": "psyche-site",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.23.4"
  },
  "scripts": {
    "stage": "python3 ../tools/publish/stage.py --target site",
    "dev": "npm run stage && astro dev",
    "build": "npm run check:og && npm run stage && astro check && astro build && npm run check:spacing && npm run check:refs && npm run check:budget && npm run check:seo",
    "preview": "astro preview",
    "test": "node --test src/lib/plan.test.ts src/lib/maze.test.ts src/lib/battery.test.ts src/lib/sheet.test.ts src/lib/seo.test.ts src/lib/feed.test.ts src/lib/pageChrome.test.ts src/lib/status.test.ts src/lib/searchOverride.test.ts scripts/sitemap-lastmod.test.mjs scripts/table-region.test.mjs scripts/a11y-tools.test.mjs",
    "diagrams": "node scripts/render-diagrams.mjs",
    "icons": "node scripts/make-icons.mjs",
    "og": "node scripts/make-og.mjs",
    "check:diagrams": "python3 -B ../tools/publish/diagrams.py --check",
    "check:spacing": "node scripts/check-spacing.mjs",
    "check:refs": "node scripts/check-refs.mjs",
    "check:budget": "node scripts/check-budget.mjs",
    "check:og": "python3 -B ../tools/publish/og.py --check",
    "check:seo": "node scripts/check-seo.mjs",
    "check:a11y": "node scripts/check-a11y.mjs"
  },
  "dependencies": {
    "@astrojs/react": "7.1.1",
    "@astrojs/sitemap": "3.7.4",
    "@astrojs/starlight": "0.42.6",
    "@fontsource-variable/instrument-sans": "5.3.0",
    "@fontsource-variable/martian-mono": "5.3.0",
    "@fontsource-variable/unbounded": "5.3.0",
    "astro": "7.4.2",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.12",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "starlight-links-validator": "0.27.0",
    "typescript": "5.9.3"
  }
}
