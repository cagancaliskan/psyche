# Office temp / lock files
~$*

# Phase 2B: raw association-norm data (large; SWOW license disallows redistribution).
# See experiments/data/README.md for how to obtain it locally.
experiments/data/*.csv
experiments/data/*.tsv

# Phase 1c §6.2 experiment: regenerable result artifacts (deterministic). The external
# Louvain partition's SHA-256 is recorded in docs/experiments/EXP-1c-swow-recovery.md §3.1
# and is reproducible via experiments/exp1c_build_partition.py, so the big partition file and
# its build log are not tracked.
experiments/results/exp1c_external_partition.tsv
experiments/results/exp1c_partition_build.txt
.obsidian/

# Docs site (D-031): dependencies, build output, and content staged by tools/publish/stage.py.
# Staged copies must never be tracked; CI fails if one is.
website/node_modules/
website/dist/
website/.astro/
website/src/content/docs/
website/src/data/

# Generated publishing output (scratch builds); regenerated from the repository.
build/
